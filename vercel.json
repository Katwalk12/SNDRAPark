{
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "/api/php-proxy?path=backend/:path*"
    },
    {
      "source": "/forgot-password.php",
      "destination": "/api/php-proxy?path=forgot-password.php"
    },
    {
      "source": "/verify-reset-otp.php",
      "destination": "/api/php-proxy?path=verify-reset-otp.php"
    },
    {
      "source": "/check-reset-otp.php",
      "destination": "/api/php-proxy?path=check-reset-otp.php"
    },
    {
      "source": "/reset-password.php",
      "destination": "/api/php-proxy?path=reset-password.php"
    },
    {
      "source": "/send-reset-otp.php",
      "destination": "/api/php-proxy?path=send-reset-otp.php"
    },
    {
      "source": "/parking-booth-dashboard.php",
      "destination": "/api/php-proxy?path=parking-booth-dashboard.php"
    },
    {
      "source": "/",
      "destination": "/frontend/pages/index.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/pages/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/pages/signup.html"
    },
    {
      "source": "/dashboard",
      "destination": "/frontend/pages/user-dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/pages/admin-login.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/frontend/pages/admin-dashboard.html"
    },
    {
      "source": "/booth",
      "destination": "/frontend/pages/booth-login.html"
    },
    {
      "source": "/booth/dashboard",
      "destination": "/frontend/pages/parking-booth.html"
    },
    {
      "source": "/terms",
      "destination": "/frontend/pages/terms.html"
    }
  ]
}
