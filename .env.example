# Copy this file to .env and fill in real values. .env is git-ignored.

APP_URL=http://localhost/sndraPark

# Set to true to log per-request tracing from the polled booth endpoints.
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sndrapark_db
DB_USER=root
DB_PASSWORD=

# Gmail SMTP. MAIL_PASSWORD is a Google App Password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SNDRAPark

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/sndraPark/backend/auth/google_callback.php
GOOGLE_LOGIN_SUCCESS_REDIRECT=frontend/pages/user-dashboard.html
GOOGLE_LOGIN_FAILURE_REDIRECT=frontend/pages/login.html
OAUTH_GOOGLE_CLIENT_ID=

# --- Arduino slot-sensor rig -------------------------------------------------
# Only used by backend/cli/serial-bridge.php. With no sensors mapped, none of
# this matters and availability works exactly as it did before.
#
# SENSOR_BRIDGE_SOURCE: proc, where a PowerShell helper owns the port. This is
#   the recommended one. Or com, where PHP opens COMn: directly and only
#   COM1-COM9 resolve. Or stdin, or sim.
# Keep parentheses, pipes and stray quotes out of these comments: PHP reads this
# file with parse_ini_file, which treats them as operators even on a # line and
# fails the whole file, silently returning every setting to its default.
SENSOR_BRIDGE_SOURCE=proc
SENSOR_SERIAL_PORT=COM3
SENSOR_SERIAL_BAUD=115200
# How old a reading may be before a bay falls back to reservation data.
# Clamped to 15-3600 seconds whatever is written here.
SENSOR_STALE_SECONDS=120
# A board printing a human-readable distance line instead of framed lines needs
# an identity, since a plain line carries none. Leave unset for a board running
# the bundled sketch.
SENSOR_DEVICE_ID=
SENSOR_DEVICE_PIN=
SENSOR_OCCUPIED_BELOW_CM=100
# What the server sends back down the cable.
#   lcd   the framed LCD line for the entrance sign. The default.
#   slot  a bare 'R' or 'A' for a one-bay board that lights a reserved lamp,
#         such as backend/iot/sensor.ino. Needs SENSOR_DEVICE_ID and
#         SENSOR_DEVICE_PIN, because the lamp has to land on a mapped bay.
#   none  say nothing back.
# Never 'lcd' for a board that reads single-char commands: the LCD text contains
# an R and an A, and the lamp would flap every refresh.
SENSOR_DOWNLINK=lcd
