# Copy this file to .env and fill in real values. .env is git-ignored.

APP_URL=http://localhost/sndraPark

# Set to true to log per-request tracing from the polled booth endpoints.
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sndrapark_db
DB_USER=root
DB_PASSWORD=

# Gmail SMTP. MAIL_PASSWORD is a Google App Password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SNDRAPark

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/sndraPark/backend/auth/google_callback.php
GOOGLE_LOGIN_SUCCESS_REDIRECT=frontend/pages/user-dashboard.html
GOOGLE_LOGIN_FAILURE_REDIRECT=frontend/pages/login.html
OAUTH_GOOGLE_CLIENT_ID=
